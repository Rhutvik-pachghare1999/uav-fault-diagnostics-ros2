__pycache__/
*.pyc

# Large regenerable artifacts (rebuild via reproduce.sh):
#  - ML datasets (windowed / augmented HDF5)
*.h5
#  - Raw simulator flight logs (300+ MB; meta.json manifests ARE tracked)
isaac_dataset/**/*.csv
isaac_dataset_legacy/
#  - ROS2 workspace build output (colcon)
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/
#  - colcon logs when building from the repo root
log/
#  - Vendored node scripts (copied from scripts/ by setup.py at build time)
ros2_ws/src/uav_aegis/uav_aegis/vendor/
#  - Runtime training log (train_cnn.py writes here on every run; the real
#    sealed history is results/train_history_sealed.json)
logs/train.log
#  - Verbose per-epoch training progress logs (tqdm spam, 12+ MB)
logs/train_sealed.log
logs/train_imu9.log
